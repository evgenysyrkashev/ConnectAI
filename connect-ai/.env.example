# Copy to .env (gitignored) for local runs; `make dev` and the scripts read it automatically.
# Real environment variables win over .env. In staging, secrets come from GCP Secret Manager instead.
# Local dev needs none of this: the defaults are memory store, fake mail, fake LLM, embedded kit mock.

APP_ENV=local
SERVICE_ROLE=all
SNAPSHOT_DATE=2026-11-06

# --- GCP (needed when any mode below is real) ---
# GCP_PROJECT_ID=your-project
# STORE_MODE=firestore            # needs `gcloud auth application-default login`
# LLM_MODE=vertex
# VERTEX_LOCATION=europe-west1
# LLM_MODEL=gemini-2.5-flash-lite # cheapest Flash-Lite on Vertex; check the current GA id, switch to a Flash model if `make eval` misses

# --- Gmail (MAIL_MODE=gmail) ---
# MAIL_MODE=gmail
# GMAIL_ADDRESS=connect.demo.team@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=            # written by: python -m scripts.authorize_gmail --target env
# DEMO_RECIPIENT_TEMPLATE=you+{entity}@gmail.com
# RECIPIENT_ALLOWLIST=you@gmail.com
# TOKEN_HMAC_KEY=                 # optional locally; required (32+ chars) when APP_ENV=staging

# --- WhatsApp (WA_MODE=meta) ---
# WA_MODE=meta
# WA_GRAPH_VERSION=v21.0          # use the current Graph API version from Meta's docs
# WA_PHONE_NUMBER_ID=
# WA_WABA_ID=
# WA_ACCESS_TOKEN=                # permanent system-user token
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=                # any random string, also entered in the Meta webhook settings
# PHONE_ALLOWLIST=+358401111111;+358402222222   # the verified test recipients
# DEMO_PHONE_MAP=*=+358401111111

# --- Yext sandbox mirror  ---
# YEXT_SANDBOX_API_KEY=
